# Copy this file to server/.env.test and fill in your values.
# server/.env.test is git-ignored — never commit real keys.

# Required
EXTERNAL_API_ENABLED=true
EXTERNAL_API_KEY=your-api-key-here

# Optional – defaults shown
EXTERNAL_API_BASE_URL=https://hbl.fmp.sportradar.com
EXTERNAL_API_LANGUAGE=de
EXTERNAL_API_TIMEZONE=Europe:Berlin
EXTERNAL_API_PRODUCT=gismo
EXTERNAL_API_KEY_AS_QUERY_PARAM=true
EXTERNAL_API_KEY_QUERY_PARAM_NAME=api_key

# IDs needed for the parameterised tests (leave blank to skip those tests)
#EXTERNAL_API_PHASE_ID=
#EXTERNAL_API_TOURNAMENT_ID=
#EXTERNAL_API_SEASON_ID=
#EXTERNAL_API_TEAM_ID=

