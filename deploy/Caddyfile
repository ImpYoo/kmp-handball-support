:80 {
    @api path /api/* /health
    reverse_proxy @api handball-backend:8090
    reverse_proxy coaching-web:8080
    encode gzip
    header {
        X-Frame-Options DENY
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
}