# Server bootstrap
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=AdminPass123!

# API configuration
BASE_API_URL=http://localhost:8080

# JWT settings
JWT_SECRET=change-this-secret-for-real-use
JWT_ISSUER=de.exhumedo.kmp.handball_support
JWT_AUDIENCE=handball-support-api
JWT_REALM=handball-support
JWT_TTL_SECONDS=3600

# Storage files
AUTH_USERS_FILE=server/data/auth-users.json
PERFORMANCE_EVALUATIONS_FILE=server/data/performance-evaluations.json

# CORS configuration (allow web app to call backend from different port)
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082,http://192.168.178.85:8081,http://192.168.178.85:8082

# Sportradar integration
# Set EXTERNAL_API_ENABLED=true and fill in the real API key to talk to Sportradar.
EXTERNAL_API_ENABLED=true
EXTERNAL_API_BASE_URL=https://hbl.fmp.sportradar.com
EXTERNAL_API_ACCESS_LEVEL=internal
EXTERNAL_API_LANGUAGE=de
EXTERNAL_API_TIMEZONE=Europe:Berlin
EXTERNAL_API_PRODUCT=gismo
EXTERNAL_API_KEY=YOUR_API_KEY_HERE
EXTERNAL_API_KEY_HEADER=X-API-Key
EXTERNAL_API_KEY_AS_QUERY_PARAM=false
EXTERNAL_API_TOURNAMENTS_FILE=server/data/tournaments.json

