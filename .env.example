# Server bootstrap
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=AdminPass123!

# JWT settings
JWT_SECRET=change-this-secret-for-real-use
JWT_ISSUER=de.exhumedo.kmp.handball_support
JWT_AUDIENCE=handball-support-api
JWT_REALM=handball-support
JWT_TTL_SECONDS=3600
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Storage files
AUTH_USERS_FILE=server/data/auth-users.json
PERFORMANCE_EVALUATIONS_FILE=server/data/performance-evaluations.json

# Sportradar FMP Handball Datafeed API
EXTERNAL_API_ENABLED=true
EXTERNAL_API_BASE_URL=https://hbl.fmp.sportradar.com
EXTERNAL_API_LANGUAGE=en
EXTERNAL_API_TIMEZONE=Europe:Berlin
EXTERNAL_API_PRODUCT=gismo
EXTERNAL_API_KEY=your-sportradar-api-key-here
EXTERNAL_API_KEY_AS_QUERY_PARAM=true
EXTERNAL_API_KEY_QUERY_PARAM_NAME=api_key
EXTERNAL_API_REQUEST_TIMEOUT_MS=10000
EXTERNAL_API_CONNECT_TIMEOUT_MS=5000

